; RUN: llc -mtriple=powerpc-unknown-linux-gnu -o - %s | FileCheck %s
; RUN: llc -mtriple=powerpc64-unknown-linux-gnu -o - %s | FileCheck %s --check-prefix=CHECK-PPC64
