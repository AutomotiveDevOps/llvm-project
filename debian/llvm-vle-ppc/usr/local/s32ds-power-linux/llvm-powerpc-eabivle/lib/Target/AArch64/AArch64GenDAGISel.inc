  return CurDAG->getTargetConstant(2 * N->getZExtValue(), SDLoc(N), MVT::i64);

  }
  case 29: {  
    ConstantSDNode *N = cast<ConstantSDNode>(V.getNode());

  return CurDAG->getTargetConstant(N->getSExtValue() / 16, SDLoc(N), MVT::i64);

  }
