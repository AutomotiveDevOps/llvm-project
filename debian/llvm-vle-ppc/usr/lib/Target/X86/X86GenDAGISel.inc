#if defined(GET_DAGISEL_BODY) || DAGISEL_INLINE
bool DAGISEL_CLASS_COLONCOLON CheckPatternPredicate(unsigned PredNo) const
#if DAGISEL_INLINE
  override
#endif
{
  switch (PredNo) {
  default: llvm_unreachable("Invalid predicate in table?");
  case 0: return (Subtarget->hasAVX()) && (!Subtarget->hasVLX());
  case 1: return (Subtarget->hasSSE1() && !Subtarget->hasAVX());
  case 2: return (Subtarget->hasAVX512()) && (Subtarget->hasVLX());
  case 3: return (Subtarget->hasSSE2() && !Subtarget->hasAVX());
  case 4: return (Subtarget->hasSSE2());
  case 5: return (Subtarget->hasVLX());
  case 6: return (Subtarget->hasAVX512());
  case 7: return (Subtarget->hasSSE4A());
  case 8: return (Subtarget->is64Bit());
  case 9: return (!Subtarget->slowIncDec() || shouldOptForSize(MF));
  case 10: return (Subtarget->is64Bit()) && (!Subtarget->slowIncDec() || shouldOptForSize(MF));
  case 11: return (Subtarget->hasF16C()) && (!Subtarget->hasVLX());
  case 12: return (Subtarget->hasAVX() && !Subtarget->hasAVX512());
  case 13: return (Subtarget->hasSSE41() && !Subtarget->hasAVX());
  case 14: return (Subtarget->hasAVX()) && (!Subtarget->hasBWI());
  case 15: return (Subtarget->hasBWI());
  case 16: return (Subtarget->hasAVX() && !Subtarget->hasAVX2());
  case 17: return (Subtarget->hasAVX2()) && (!Subtarget->hasVLX());
  case 18: return (Subtarget->hasAVX()) && (!Subtarget->hasDQI());
  case 19: return (Subtarget->hasDQI());
  case 20: return (!TM.isPositionIndependent()) && (TM.getCodeModel() == CodeModel::Small ||TM.getCodeModel() == CodeModel::Kernel);
  case 21: return (MF->getFunction().hasMinSize());
  case 22: return (Subtarget->hasMOVBE());
  case 23: return (!Subtarget->hasSSE1());
  case 24: return (!Subtarget->hasSSE2());
  case 25: return (Subtarget->hasBWI()) && (Subtarget->hasVLX());
  case 26: return (Subtarget->hasMMX());
  case 27: return (!Subtarget->hasAVX());
  case 28: return (Subtarget->hasAVX());
  case 29: return (Subtarget->hasAVX2());
  case 30: return (Subtarget->hasVBMI2());
  case 31: return (Subtarget->hasVBMI2()) && (Subtarget->hasVLX());
  case 32: return (Subtarget->hasMMX()) && (Subtarget->hasSSE1());
  case 33: return (Subtarget->hasMMX()) && (Subtarget->hasSSSE3());
  case 34: return (Subtarget->hasSSE42());
  case 35: return (Subtarget->hasMMX()) && (Subtarget->hasSSE2());
  case 36: return (Subtarget->has3DNow());
  case 37: return (Subtarget->hasSHA());
  case 38: return (Subtarget->hasAES()) && (Subtarget->hasAVX());
  case 39: return (Subtarget->hasAES()) && (!Subtarget->hasAVX());
  case 40: return (Subtarget->hasPCLMUL()) && (!Subtarget->hasAVX());
  case 41: return (Subtarget->hasAVX()) && (Subtarget->hasPCLMUL()) && (!Subtarget->hasVLX() || !Subtarget->hasVPCLMULQDQ());
  case 42: return (Subtarget->hasVLX()) && (Subtarget->hasVPCLMULQDQ());
  case 43: return (Subtarget->hasVPCLMULQDQ()) && (!Subtarget->hasVLX());
  case 44: return (Subtarget->hasAVX512()) && (Subtarget->hasVPCLMULQDQ());
  case 45: return (Subtarget->hasXOP());
  case 46: return (Subtarget->hasSSSE3() && !Subtarget->hasAVX());
  case 47: return (Subtarget->hasAES()) && (Subtarget->hasAVX()) && (!Subtarget->hasVLX() || !Subtarget->hasVAES());
  case 48: return (Subtarget->hasVAES()) && (Subtarget->hasVLX());
  case 49: return (Subtarget->hasVAES()) && (!Subtarget->hasVLX());
  case 50: return (Subtarget->hasAVX512()) && (Subtarget->hasVAES());
  case 51: return (shouldOptForSize(MF)) && (Subtarget->hasSSE1() && !Subtarget->hasAVX());
  case 52: return (Subtarget->hasAVX()) && (shouldOptForSize(MF));
  case 53: return (Subtarget->hasPRFCHW());
  case 54: return (Subtarget->hasPREFETCHWT1());
  case 55: return (Subtarget->hasSSEPrefetch());
  case 56: return (Subtarget->has3DNow()) && (!Subtarget->hasSSEPrefetch());
  case 57: return (Subtarget->hasLWP());
  case 58: return (Subtarget->hasPTWRITE());
  case 59: return (Subtarget->hasPTWRITE()) && (Subtarget->is64Bit());
  case 60: return (Subtarget->hasMOVDIRI());
