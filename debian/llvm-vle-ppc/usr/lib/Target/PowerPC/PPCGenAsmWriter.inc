    printU1ImmOperand(MI, 1, O);
    O << ", ";
    printOperand(MI, 0, O);
    O << ", ";
    printOperand(MI, 2, O);
    O << ", ";
    printU2ImmOperand(MI, 3, O);
    return;
    break;
